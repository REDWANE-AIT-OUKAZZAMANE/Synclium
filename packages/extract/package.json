{
  "name": "@openinvoicebridge/extract",
  "version": "0.1.0",
  "license": "MIT",
  "description": "AI-powered invoice extraction into the canonical schema (provider-agnostic)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "eval:gemini": "tsx scripts/eval.ts --provider gemini",
    "eval:anthropic": "tsx scripts/eval.ts --provider anthropic"
  },
  "dependencies": {
    "@openinvoicebridge/core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
