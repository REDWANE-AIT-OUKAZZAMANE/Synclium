{
  "name": "@synclium-com/ubl",
  "version": "0.1.0",
  "license": "MIT",
  "description": "UBL 2.1 / PEPPOL BIS Billing 3.0 importer, exporter, validator",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@synclium-com/core": "workspace:*",
    "fast-xml-parser": "^4.5.1",
    "xmlbuilder2": "^3.1.1",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
