{
  "name": "synclium",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Universal e-invoice interoperability & synchronization engine — TypeScript/JavaScript SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@synclium/core": "workspace:*",
    "@synclium/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  }
}
