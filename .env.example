# ==============================================================================
# Synclium - Environment Configuration
# ==============================================================================

# AI Extraction Providers
# ------------------------------------------------------------------------------
# 1. Google Gemini Flash (Recommended / 100% Free Tier up to 1,500 req/day)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=

# 2. Anthropic Claude (Optional / Paid fallback)
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Persistent Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
# REST-based serverless Redis for atomic rate-limiting counters.
# Get free credentials at: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret salt used to hash client IP addresses with SHA-256 before key generation.
# Raw IP addresses are NEVER logged or persisted.
IP_HASH_SALT=synclium-default-secret-salt-change-in-production

# Rate Limit Thresholds
# ------------------------------------------------------------------------------
RATE_LIMIT_ANON_DAILY=1           # Scans per day for anonymous users (keyed by IP hash)
RATE_LIMIT_AUTH_DAILY=3           # Scans per day for authenticated users (keyed by GitHub ID)
RATE_LIMIT_GENERAL_PER_MIN=30     # Max requests/min for /convert and /validate per IP hash

# GitHub OAuth Authentication (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Homepage URL: https://synclium.vercel.app (or http://localhost:3000)
# Authorization callback URL: https://synclium.vercel.app/api/auth/callback/github
AUTH_SECRET=generate-a-32-byte-secret-via-openssl-rand-hex-32
NEXTAUTH_SECRET=generate-a-32-byte-secret-via-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudflare Turnstile Bot Mitigation
# ------------------------------------------------------------------------------
# Create a Turnstile widget at: https://dash.cloudflare.com/?to=/:account/turnstile
# In dev/test mode, you can use Cloudflare's official always-pass test keys:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x00000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA

# REST API Server Configuration (packages/api)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
