{
  "name": "openinvoicebridge",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open-source universal e-invoice interoperability engine",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "packages/formats/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:api": "pnpm --filter @synclium/api dev",
    "dev:web": "pnpm --filter @synclium/web-demo dev"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
